{
  "name": "sgs-backend",
  "version": "1.0.0",
  "description": "Smart Academic Timetable Scheduling System Core API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/utils/seeder.js",
    "seed:massive": "node src/utils/massiveSeeder.js",
    "test:clashes": "node src/utils/testValidatorClashes.js",
    "test:notifications": "node src/utils/testNotifications.js",
    "test:email": "node src/utils/testBrevoEmail.js",
    "test:faulty": "py solver/test_faulty_scenarios.py",
    "solver": "py solver/worker.py",
    "benchmark": "py solver/benchmark_large_dataset.py"
