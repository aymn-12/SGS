PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/sgs_timetable

# JWT Secret
JWT_SECRET=super_secret_jwt_key_sgs_academic_2026
JWT_EXPIRES_IN=7d

# Redis Configuration (For Job Queue & Pub/Sub)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Celery / Solver Queue Names
SOLVER_QUEUE_NAME=timetable_solver_tasks

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# Brevo (Sendinblue) Email Service Configuration
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_NAME=نظام الجداول الأكاديمية - SGS
BREVO_SENDER_EMAIL=notifications@sgs-academic.edu
